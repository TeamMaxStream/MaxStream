{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "watch_history": {
          "$key": {
            ".read": "$uid === auth.uid",
            ".write": "$uid === auth.uid"
          }
        },
        "watchlist": {
          "$key": {
            ".read": "$uid === auth.uid",
            ".write": "$uid === auth.uid"
          }
        },
        "profile": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        },
        "provider_preferences": {
          "$key": {
            ".read": "$uid === auth.uid",
            ".write": "$uid === auth.uid"
          }
        },
        "user_preferences": {
          "$key": {
            ".read": "$uid === auth.uid",
            ".write": "$uid === auth.uid"
          }
        }
      }
    },

    "device_codes": {
      ".read": false,
      "$code": {
        ".read": false,
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid && newData.child('code').val() === $code && newData.child('isUsed').val() === false && newData.child('expiresAt').val() > now && newData.child('expiresAt').val() <= now + 900000 && !newData.child('password').exists()",
        ".validate": "newData.hasChildren(['code', 'userId', 'createdAt', 'expiresAt', 'isUsed'])"
      }
    },

    "tv_authenticated_sessions": {
      ".read": false,
      ".write": false
    },
    "biometric_sessions": {
      ".read": false,
      ".write": false
    },
    "login_audits": {
      ".read": false,
      ".write": false
    }
  }
}
