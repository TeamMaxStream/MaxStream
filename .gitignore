local.properties

.mimocode

# Firebase / Firestore rules
dart_tv_reference
.agents
.firebaserc
skills-lock.json
.jsonfirebasercerror.txt

# Bundled VLC runtime (populated at build time by :desktop:syncVlcRuntime)
desktop/src/main/resources/vlc/
