# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Keystore files
*.jks
key.jks

# Firebase/Google Services configuration (contains sensitive credentials)
google-services.json
**/android/**/google-services.json
**/ios/**/GoogleService-Info.plist

# Signing credentials (contains sensitive keystore passwords)
keystore.properties
